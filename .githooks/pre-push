#!/bin/sh
# Impide publicar cambios si las pruebas del proyecto fallan.
cd "$(git rev-parse --show-toplevel)/proyecto-demo" || exit 1
python -B -m unittest discover -s tests -v
status=$?
if [ "$status" -ne 0 ]; then exit "$status"; fi

# Mantener las pruebas de proyecto-demo y ejecutar también el control de login.
exec sh "$(git rev-parse --show-toplevel)/proyecto-login/pre-push"
